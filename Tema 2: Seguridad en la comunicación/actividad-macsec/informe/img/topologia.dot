digraph macsec {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad=0.35, nodesep=0.8, ranksep=1.0];
  node [shape=box, style="rounded,filled", fillcolor="#eef3ff", color="#3949ab", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#455a64"];

  host [label="Host\n192.168.56.1", fillcolor="#f5f5f5", color="#78909c"];
  mv1  [label="MV1 · bocata-jamon\nenp0s9  08:00:27:17:ce:47\nmacsec0  1.1.1.1/24"];
  mv2  [label="MV2 · bocata-jamon2\nenp0s9  08:00:27:d1:03:ae\nmacsec1  1.1.1.2/24"];
  net  [label="NAT Network\nmacsecnet\n10.0.3.0/24", shape=ellipse, fillcolor="#e8f5e9", color="#2e7d32"];

  { rank=same; mv1; mv2; }
  host -> mv1 [label="host-only", style=dashed];
  host -> mv2 [label="host-only", style=dashed];
  mv1 -> net [label="enp0s9", dir=both];
  mv2 -> net [label="enp0s9", dir=both];
  mv1 -> mv2 [label="MACsec (0x88e5)", color="#c62828", penwidth=2, constraint=false];
}
